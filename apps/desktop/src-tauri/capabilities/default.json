{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "padrao",
  "description": "Permissões da janela principal",
  "windows": [
    "principal"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-set-theme",
    "dialog:allow-open",
    "dialog:allow-save",
    "notification:default",
    "updater:default",
    "process:allow-restart"
  ]
}
